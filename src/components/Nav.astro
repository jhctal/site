---
const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/projects", label: "Projects" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<nav aria-label="Main" class="flex justify-center px-6 pt-6">
  <ul class="flex gap-1 rounded-2xl border border-white bg-white/70 p-1 backdrop-blur-[50px]">
    {links.map(({ href, label }) => (
      <li>
        <a
          href={href}
          aria-current={path === href ? "page" : undefined}
          class="relative block rounded-xl px-4 py-2 text-[#4b5563] transition-colors duration-200 hover:bg-white hover:text-[#111827] aria-[current=page]:font-semibold aria-[current=page]:text-[#111827]"
        >
          {path === href && (
            <span class="absolute inset-0 rounded-xl bg-white [view-transition-name:nav-active]" />
          )}
          <span
            class="relative z-10 [view-transition-class:nav-label]"
            style={`view-transition-name: nav-${label.toLowerCase()}`}
          >
            {label}
          </span>
        </a>
      </li>
    ))}
  </ul>
</nav>
