---
import { Image } from "astro:assets";
import photo from "../assets/photo.jpeg";
import SocialLinks from "./SocialLinks.astro";
---

<main class="flex flex-1 justify-center px-6 py-10 md:px-12">
  <section class="flex flex-col justify-center">
    <div class="flex flex-col items-center gap-6 md:flex-row md:gap-4">
      <Image
        alt="Portrait of Latch"
        src={photo}
        height="300"
        width="300"
        class="size-40 shrink-0 rounded-4xl object-cover md:size-[300px] hover:scale-105 hover:-rotate-3 transition-transform duration-200"
        layout="constrained"
      />
      <div class="flex max-w-3xl flex-col items-center gap-3 text-center md:items-start md:text-left">
        <h1 class="text-3xl font-bold md:text-4xl">Hi! I'm Latch</h1>
        <p>A software engineer and designer based in London.</p>
        <p>
          I'm an animation graduate who followed my curiosity about computers
          and the web and became a developer.
        </p>
        <p>Say hello on LinkedIn, or see what I'm building on GitHub.</p>
        <SocialLinks class="mt-2" />
      </div>
    </div>
  </section>
</main>
