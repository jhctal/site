---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const projects = (await getCollection("projects")).toSorted(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout
  title="Projects – Latchlern Jack"
  description="Things Latch has designed and built."
>
  <main class="mx-auto flex w-full max-w-3xl flex-1 flex-col gap-6 px-12 py-16">
    <h1 class="text-4xl font-bold">Projects</h1>
    <ul class="grid gap-4 sm:grid-cols-2">
      {projects.map(({ data }) => (
        <li class="flex flex-col gap-3 rounded-2xl border border-white bg-white/70 p-5 backdrop-blur-[50px]">
          <div class="flex items-start justify-between gap-3">
            <h2 class="text-xl font-bold text-[#111827]">{data.title}</h2>
            {data.status && (
              <span class="shrink-0 rounded-full border border-[#111827]/15 px-3 py-1 text-xs font-semibold text-[#111827]">
                {data.status}
              </span>
            )}
          </div>
          <p class="text-[#4b5563]">{data.description}</p>
          {data.tags.length > 0 && (
            <ul class="flex flex-wrap gap-2" aria-label="Built with">
              {data.tags.map((tag) => (
                <li class="rounded-full bg-white px-3 py-1 text-sm text-[#4b5563]">
                  {tag}
                </li>
              ))}
            </ul>
          )}
          {(data.url || data.repo) && (
            <div class="mt-auto flex gap-4 pt-2 font-semibold text-[#111827]">
              {data.url && (
                <a href={data.url} class="underline-offset-4 hover:underline">
                  Visit site
                </a>
              )}
              {data.repo && (
                <a href={data.repo} class="underline-offset-4 hover:underline">
                  Source code
                </a>
              )}
            </div>
          )}
        </li>
      ))}
    </ul>
  </main>
</Layout>
