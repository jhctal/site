---
const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/projects", label: "Projects" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<nav aria-label="Main" class="flex justify-center px-6 pt-6">
  <ul class="flex gap-1 rounded-2xl border border-white bg-white/70 p-1 backdrop-blur-[50px]">
    {links.map(({ href, label }) => (
      <li>
        <a
          href={href}
          aria-current={path === href ? "page" : undefined}
          class="block rounded-xl px-4 py-2 text-[#4b5563] transition-colors duration-200 hover:bg-white hover:text-[#111827] aria-[current=page]:bg-white aria-[current=page]:font-semibold aria-[current=page]:text-[#111827]"
        >
          {label}
        </a>
      </li>
    ))}
  </ul>
</nav>
